# Supabase project URL and publishable/anon key. Never put a service-role key here.
# Client keys are visible in the browser; enforce access through RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional, development only: isolated in-memory preview, never real Supabase data.
VITE_ARENA_DEMO=false

# Coordonnées publiques et paiement BaridiMob / CCP (optionnel — affichées dans Abonnement & Mentions légales)
VITE_OFFICIAL_EMAIL=
VITE_REGISTRATION_REFERENCE=
VITE_BARIDIMOB_RIP=
VITE_CCP_ACCOUNT=
VITE_CCP_HOLDER=

# Server-side secrets must not use a VITE_ prefix or be embedded in the client.
# SlickPay Algeria API v2 (CIB / Edahabia — SATIM) — configure via `npx supabase secrets set`:
SLICKPAY_PUBLIC_KEY=
SLICKPAY_SECRET_KEY=
SLICKPAY_ENV=production
SLICKPAY_ACCOUNT_TYPE=auto
SLICKPAY_ACCOUNT_UUID=
